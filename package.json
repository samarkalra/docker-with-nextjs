{
  "name": "nextjs-with-docker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:qa": "dotenv -e .env.qa -- next dev",
    "dev:stage": "dotenv -e .env.stage -- next dev",
    "build": "next build",
    "build:qa": "dotenv -e .env.qa -- next build",
    "build:stage": "dotenv -e .env.stage -- next build",
    "build:prod": "dotenv -e .env.production -- next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
